# Base URL of the FastAPI backend (see backend/). With it set, the create
# page runs the real order flow against the backend. Without it, the page
# falls back to a clearly labelled local demo that saves nothing.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000

# No auth secret belongs here: sessions are an httponly cookie the backend
# sets directly, never a token read from client-side env. lib/api/auth.ts
# and lib/api/orders.ts read the (non-httponly) CSRF cookie by its literal
# name "blinkora_csrf" — keep that in sync with the backend's
# CSRF_COOKIE_NAME if you ever change it from the default.
