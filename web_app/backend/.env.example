# Copy to backend/.env. Nothing here is a secret; real keys go only in .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Legacy free-text chat (/api/chat/message) ---
CHATBOT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Video generation ---
# Only "mock" exists. Any other value stops the server at first use, so a
# typo can never start paid generation.
VIDEO_GENERATION_PROVIDER=mock
MOCK_GENERATION_SECONDS=8
CLIP_SECONDS=5
CLIP_RESOLUTION=720p

# --- Orders (P0.5: Postgres-backed) ---
# postgres = the real store. file = JSON files under STORAGE_DIR (no-database
# dev loop only). memory = fast, isolated tests; both are lost on restart.
ORDER_STORE=postgres
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# F1 "both": leave off until the square crop is tested and a price is set.
BOTH_FORMATS_ENABLED=false
BOTH_FORMATS_ADDON_BDT=
# Set to enable GET /api/internal/orders/{id} (prompts + order line) for the operator.
OPERATOR_API_TOKEN=

# --- Database (P0.5) ---
# See docker-compose.yml for a local Postgres on host port 55432 (5432 is
# left free in case a native Postgres install already uses it).
DATABASE_URL=postgresql+psycopg://blinkora:blinkora_dev@localhost:55432/blinkora

# --- Auth sessions (P0.5) ---
SESSION_COOKIE_NAME=blinkora_session
CSRF_COOKIE_NAME=blinkora_csrf
SESSION_TTL_DAYS=14
# Secure cookies require HTTPS. Only false for plain-http local dev; set
# true behind TLS in any shared/staging/production deployment.
COOKIE_SECURE=false
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
