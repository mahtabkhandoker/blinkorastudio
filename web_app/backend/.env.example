# Copy to backend/.env. Nothing here is a secret; real keys go only in .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Legacy free-text chat (/api/chat/message) ---
CHATBOT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Video generation ---
# Only "mock" exists. Any other value stops the server at first use, so a
# typo can never start paid generation.
VIDEO_GENERATION_PROVIDER=mock
MOCK_GENERATION_SECONDS=8
CLIP_SECONDS=5
CLIP_RESOLUTION=720p

# --- Orders (P0 workflow) ---
# file = JSON files under STORAGE_DIR (development only), memory = lost on restart
ORDER_STORE=file
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# F1 "both": leave off until the square crop is tested and a price is set.
BOTH_FORMATS_ENABLED=false
BOTH_FORMATS_ADDON_BDT=
# Set to enable GET /api/internal/orders/{id} (prompts + order line) for the operator.
OPERATOR_API_TOKEN=
